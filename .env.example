# Listen address. Default is loopback only.
WG_LISTEN=127.0.0.1:8081

# SQLite database path
WG_DB_PATH=wireguard.db

# JWT signing secret (min 16 chars). If empty, a secret is created next to the DB as .jwt_secret
# WG_JWT_SECRET=
# WG_JWT_SECRET_FILE=/var/lib/wireguard-ui/.jwt_secret

# Trust X-Forwarded-For / X-Real-IP from private proxies
WG_TRUST_PROXY=false

# Directory that may be read/written for .conf files
WG_CONFIG_DIR=/etc/wireguard

# Comma-separated browser origins for CORS (dev Vite)
WG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Enable gin debug logs
WG_DEBUG=false

# Used only by: go run ./cmd/init
# WG_ADMIN_USER=admin
# WG_ADMIN_PASSWORD=
